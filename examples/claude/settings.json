{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash agent-knowledge/hooks/kb-session-start.sh",
            "timeout": 15000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash agent-knowledge/hooks/kb-recall.sh",
            "timeout": 20000
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash agent-knowledge/hooks/kb-session-end.sh Stop",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash agent-knowledge/hooks/kb-session-end.sh SessionEnd",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
